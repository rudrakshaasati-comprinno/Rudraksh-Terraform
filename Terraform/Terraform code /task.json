{
    "family": "poc-task",
    "networkMode": "awsvpc",
    "executionRoleArn": "arn:aws:iam::748503131867:role/poc-ecs-execution-role",
    "taskRoleArn": "arn:aws:iam::748503131867:role/poc-ecs-task-role",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "748503131867.dkr.ecr.ap-south-1.amazonaws.com/poc-my-app-repo:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "S3_BUCKET",
                    "value": "poc-rudrabucket-12345"
                },
                {
                    "name": "MEMCACHED_SERVER",
                    "value": "poc-memcached.tbfbqn.cfg.aps1.cache.amazonaws.com"
                },
                {
                    "name": "KAFKA_SERVER",
                    "value": "10.0.62.43:9092"
                },
                {
                    "name": "DB_PASS",
                    "value": "password123"
                },
                {
                    "name": "DB_USER",
                    "value": "admin"
                },
                {
                    "name": "DB_NAME",
                    "value": "mydb"
                },
                {
                    "name": "DB_HOST",
                    "value": "poc-rds.cdo242i0spsd.ap-south-1.rds.amazonaws.com"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/poc",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "systemControls": []
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512"
}
